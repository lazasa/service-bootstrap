# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
API_URL=http://localhost:3000

# External path prefix added by a reverse proxy (e.g. Kong). Leave empty for local.
# Set to the Kong route prefix for your service when deploying (e.g. /api/your-service).
DOCS_INDEX_PREFIX=

# Supabase (required — boot fails in production if missing)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Identity service (required — boot fails in production if missing)
IDENTITY_SERVICE_URL=http://localhost:3001
IDENTITY_SERVICE_TIMEOUT=30000
